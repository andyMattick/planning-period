{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-manifest.mjs && node scripts/build-backend-config.mjs",
  "installCommand": "echo 'no install needed for the site'",
  "outputDirectory": ".",
  "cleanUrls": false,
  "redirects": [
    { "source": "/", "destination": "/site/", "permanent": false }
  ],
  "headers": [
    { "source": "/site/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/site/" } ] },
    { "source": "/backend.config.json", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/site/manifest.webmanifest", "headers": [ { "key": "Content-Type", "value": "application/manifest+json" } ] }
  ]
}
