              "id": "q1",
              "level": 1,
              "skill": "limit by factoring",
              "type": "short",
              "prompt": {
                "A": "Find $\\displaystyle\\lim_{x \\to 2} \\dfrac{x^2 - 4}{x - 2}$.",
                "B": "Find $\\displaystyle\\lim_{x \\to 3} \\dfrac{x^2 - 9}{x - 3}$."
              },
              "answer": {
                "A": "$4$",
                "B": "$6$"
              },
              "why": {
                "A": "$\\dfrac{x^2 - 4}{x - 2} = x + 2$ for $x \\ne 2$, so the limit is $2 + 2 = 4$.",
                "B": "$\\dfrac{x^2 - 9}{x - 3} = x + 3$ for $x \\ne 3$, so the limit is $3 + 3 = 6$."
              },
              "math": {
                "check": {
                  "A": {
                    "type": "limit",
                    "expr": "(x^2 - 4)/(x - 2)",
                    "to": 2
                  },
                  "B": {
                    "type": "limit",
                    "expr": "(x^2 - 9)/(x - 3)",
                    "to": 3
                  }
                }
              }
            },
            {
              "id": "q2",
              "level": 1,
              "skill": "evaluate a piecewise function",
              "type": "short",
              "prompt": {
